# ---------------------------------------------------------------------------
# FinOps Platform - example environment file
# Copy to .env and adjust. .env is git-ignored.
# ---------------------------------------------------------------------------

# ---- billing-generator -----------------------------------------------------
# Where to emit generated billing records: stdout | file | broker
BILLING_SINK=stdout

# How many records per batch, and seconds between batches
BILLING_BATCH_SIZE=5
BILLING_INTERVAL_SECONDS=2

# Number of fake billing accounts/tenants to simulate
BILLING_NUM_ACCOUNTS=8

# Optional fixed seed for reproducible data (leave empty for random)
BILLING_SEED=

# File sink (used when BILLING_SINK=file)
BILLING_FILE_PATH=./data/billing.ndjson

# ---- message broker (step 2 - active) --------------------------------------
# Used when BILLING_SINK=broker.
# Red Panda -> localhost:9092   |   Apache Kafka -> localhost:9094
BROKER_BOOTSTRAP_SERVERS=localhost:9092
BROKER_TOPIC=finops.billing.raw
BROKER_CLIENT_ID=billing-generator
